{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MyShop: Build APK",
            "type": "process",
            "command": "${workspaceFolder}/gradlew",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat"
            },
            "args": [
                ":app:assembleDebug",
                "--console=plain",
                "--max-workers=2",
                "--no-parallel",
                "-Dorg.gradle.jvmargs=-Xmx1024m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "MyShop: Check",
            "type": "process",
            "command": "${workspaceFolder}/gradlew",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat"
            },
            "args": [
                ":app:assembleDebug",
                ":app:lintDebug",
                ":app:assembleDebugAndroidTest",
                "--console=plain",
                "--max-workers=2",
                "--no-parallel",
                "-Dorg.gradle.jvmargs=-Xmx1024m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "MyShop: Test UI",
            "type": "process",
            "command": "${workspaceFolder}/gradlew",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat"
            },
            "args": [
                ":app:connectedDebugAndroidTest",
                "--console=plain",
                "--max-workers=2",
                "--no-parallel",
                "-Dorg.gradle.jvmargs=-Xmx1024m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "MyShop: Devices",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/android.sh",
                "devices"
            ],
            "problemMatcher": []
        },
        {
            "label": "MyShop: Start Emulator",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/android.sh",
                "emulator"
            ],
            "problemMatcher": []
        },
        {
            "label": "MyShop: Run",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/android.sh",
                "run"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
